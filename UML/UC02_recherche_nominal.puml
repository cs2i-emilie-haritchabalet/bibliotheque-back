@startuml
title UC02 - Rechercher une ressource (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "RechercheComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
entity "RessourceRepository\n<<entity>>" as RessourceRepo
database "Base de données" as DB

Acteur -> UI : accéder à l'interface de recherche

alt UC02.1 - Recherche simple (titre uniquement)
    Acteur -> UI : saisir titre uniquement
    UI -> RessourceController : GET /ressources/recherche?q=titre
    RessourceController -> RessourceService : rechercheSimple(titre)
    RessourceService -> RessourceRepo : findByTitreContainingIgnoreCase(titre)
    RessourceRepo -> DB : SELECT * FROM ressource\nWHERE titre ILIKE ?
    DB --> RessourceRepo : liste ressources
    RessourceRepo --> RessourceService : List<RessourceDocumentaire>
    RessourceService --> RessourceController : List<RessourceResponse>
    RessourceController --> UI : 200 OK + List<RessourceResponse>

else UC02.2 - Recherche avancée (auteur, année, thème)
    Acteur -> UI : saisir un ou plusieurs critères\n(auteur, année, thème)
    UI -> RessourceController : GET /ressources/recherche/avancee\n(RechercheRessourceRequest)
    RessourceController -> RessourceService : rechercheAvancee(RechercheRessourceRequest)
    RessourceService -> RessourceRepo : rechercheAvancee\n(titre, auteur, annee, theme)
    RessourceRepo -> DB : SELECT * FROM ressource\nWHERE critères correspondants
    DB --> RessourceRepo : liste ressources
    RessourceRepo --> RessourceService : List<RessourceDocumentaire>
    RessourceService --> RessourceController : List<RessourceResponse>
    RessourceController --> UI : 200 OK + List<RessourceResponse>
end

UI --> Acteur : afficher liste des ressources\navec exemplaires et disponibilité

@enduml
