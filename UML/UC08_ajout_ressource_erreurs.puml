@startuml
title UC08 - Ajouter une ressource documentaire (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Bibliothécaire" as Acteur
boundary "RessourceFormComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
control "RessourceFactory\n<<control>>" as RessourceFactory
entity "EmplacementRepository\n<<entity>>" as EmplacementRepo
database "Base de données" as DB

Acteur -> UI : saisir les métadonnées de la ressource
UI -> RessourceController : POST /ressources\n(RessourceCreateRequest)

alt Données invalides (validation Bean)
    RessourceController -> RessourceController : @Valid échoue
    RessourceController --> UI : 400 Bad Request\n(champs obligatoires manquants)
    UI --> Acteur : message "Données invalides"

else Emplacement introuvable
    RessourceController -> RessourceService : creer(RessourceCreateRequest)
    RessourceService -> EmplacementRepo : findByCode(emplacementCode)
    EmplacementRepo -> DB : SELECT emplacement WHERE code = ?
    DB --> EmplacementRepo : résultat vide
    EmplacementRepo --> RessourceService : Optional.empty()
    RessourceService -> RessourceService : créer nouvel emplacement\nsi libelle fourni,\nsinon lever exception
    RessourceService --> RessourceController : NotFoundException\n("Emplacement introuvable")
    RessourceController --> UI : 404 Not Found
    UI --> Acteur : message "Emplacement introuvable"

else Type de ressource invalide
    RessourceController -> RessourceService : creer(RessourceCreateRequest)
    RessourceService -> RessourceFactory : create(request, emplacement)
    RessourceFactory -> RessourceFactory : type non reconnu
    RessourceFactory --> RessourceService : BusinessException\n("Type de ressource invalide")
    RessourceService --> RessourceController : BusinessException
    RessourceController --> UI : 400 Bad Request
    UI --> Acteur : message "Type de ressource invalide"
end

@enduml
