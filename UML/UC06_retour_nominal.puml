@startuml
title UC06 - Retourner un exemplaire (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "MesEmpruntsComponent\n<<boundary>>" as UI
control "EmpruntController\n<<control>>" as EmpruntController
control "EmpruntService\n<<control>>" as EmpruntService
entity "EmpruntRepository\n<<entity>>" as EmpruntRepo
entity "ExemplaireRepository\n<<entity>>" as ExemplaireRepo
database "Base de données" as DB

Acteur -> UI : sélectionner un emprunt\net demander le retour
UI -> EmpruntController : POST /emprunts/retour\n(RetourRequest: empruntId)
EmpruntController -> EmpruntService : retourner(empruntId)
EmpruntService -> EmpruntRepo : findById(empruntId)
EmpruntRepo -> DB : SELECT emprunt WHERE id = ?
DB --> EmpruntRepo : Emprunt (statut EN_COURS ou EN_RETARD)
EmpruntRepo --> EmpruntService : Emprunt

EmpruntService -> EmpruntService : emprunt.setDateRetour(today)\nemprunt.setStatut(RETOURNE)
EmpruntService -> ExemplaireRepo : save(exemplaire.statut = DISPONIBLE)
ExemplaireRepo -> DB : UPDATE exemplaire\nSET statut = DISPONIBLE
EmpruntService -> EmpruntRepo : save(emprunt)
EmpruntRepo -> DB : UPDATE emprunt\nSET statut = RETOURNE,\ndateRetour = today

DB --> EmpruntRepo : emprunt mis à jour
EmpruntRepo --> EmpruntService : Emprunt
EmpruntService --> EmpruntController : EmpruntResponse
EmpruntController --> UI : 200 OK + EmpruntResponse
UI --> Acteur : confirmation retour\n(exemplaire remis en disponibilité)

@enduml
