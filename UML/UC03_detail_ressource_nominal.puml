@startuml
title UC03 - Consulter le détail d'une ressource (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "RessourceDetailComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
entity "RessourceRepository\n<<entity>>" as RessourceRepo
database "Base de données" as DB

Acteur -> UI : sélectionner une ressource\ndans les résultats
UI -> RessourceController : GET /ressources/{id}
RessourceController -> RessourceService : detail(id)
RessourceService -> RessourceRepo : findById(id)
RessourceRepo -> DB : SELECT ressource + exemplaires\nWHERE id = ?
DB --> RessourceRepo : ressource avec exemplaires
RessourceRepo --> RessourceService : RessourceDocumentaire
RessourceService -> RessourceService : toResponse()\n(mapping + statut exemplaires)
RessourceService --> RessourceController : RessourceResponse\n(avec List<ExemplaireResponse>)
RessourceController --> UI : 200 OK + RessourceResponse
UI --> Acteur : afficher détail ressource\n(titre, auteur, exemplaires, disponibilité)

@enduml
