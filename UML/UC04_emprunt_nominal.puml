@startuml
title UC04 - Emprunter un exemplaire (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "EmpruntComponent\n<<boundary>>" as UI
control "EmpruntController\n<<control>>" as EmpruntController
control "EmpruntService\n<<control>>" as EmpruntService
control "UtilisateurService\n<<control>>" as UtilisateurService
control "RessourceService\n<<control>>" as RessourceService
entity "ExemplaireRepository\n<<entity>>" as ExemplaireRepo
entity "EmpruntRepository\n<<entity>>" as EmpruntRepo
database "Base de données" as DB

Acteur -> UI : sélectionner une ressource\net demander l'emprunt
UI -> EmpruntController : POST /emprunts\n(EmpruntCreateRequest:\nutilisateurId, ressourceId)
EmpruntController -> EmpruntService : emprunter(EmpruntCreateRequest)

EmpruntService -> UtilisateurService : getEntity(utilisateurId)
UtilisateurService -> DB : SELECT utilisateur WHERE id = ?
DB --> UtilisateurService : Utilisateur
UtilisateurService --> EmpruntService : Utilisateur

EmpruntService -> RessourceService : getEntity(ressourceId)
RessourceService -> DB : SELECT ressource WHERE id = ?
DB --> RessourceService : RessourceDocumentaire
RessourceService --> EmpruntService : RessourceDocumentaire

EmpruntService -> EmpruntRepo : findEmpruntActifByUtilisateurEtRessource\n(utilisateurId, ressourceId)
EmpruntRepo -> DB : SELECT emprunt actif\npour cet utilisateur et cette ressource
DB --> EmpruntRepo : Optional.empty()
EmpruntRepo --> EmpruntService : pas d'emprunt actif

EmpruntService -> EmpruntRepo : findRetardsByUtilisateur(utilisateurId)
EmpruntRepo -> DB : SELECT emprunts EN_RETARD\nde l'utilisateur
DB --> EmpruntRepo : liste vide
EmpruntRepo --> EmpruntService : pas de retard

EmpruntService -> EmpruntService : vérifier caution disponible\n>= cautionExigee ressource

EmpruntService -> ExemplaireRepo : findByRessourceIdAndStatut\n(ressourceId, DISPONIBLE)
ExemplaireRepo -> DB : SELECT exemplaire DISPONIBLE\npour cette ressource
DB --> ExemplaireRepo : List<Exemplaire>
ExemplaireRepo --> EmpruntService : premier exemplaire disponible

EmpruntService -> EmpruntService : créer Emprunt\n(dateEmprunt = today,\ndateRetourPrevue = today + DUREE_PRET_JOURS,\nstatut = EN_COURS)
EmpruntService -> ExemplaireRepo : save(exemplaire.statut = EMPRUNTE)
ExemplaireRepo -> DB : UPDATE exemplaire SET statut = EMPRUNTE
EmpruntService -> EmpruntRepo : save(emprunt)
EmpruntRepo -> DB : INSERT INTO emprunt

DB --> EmpruntRepo : emprunt persisté
EmpruntRepo --> EmpruntService : Emprunt
EmpruntService --> EmpruntController : EmpruntResponse
EmpruntController --> UI : 200 OK + EmpruntResponse
UI --> Acteur : confirmation emprunt\n(dates, code-barres exemplaire)

@enduml
