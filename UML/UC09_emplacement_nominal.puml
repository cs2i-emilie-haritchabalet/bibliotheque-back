@startuml
title UC09 - Associer un emplacement à une ressource (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

note over RessourceService
  UC09 est intégré à UC08 lors de la création.
  Ce diagramme montre la résolution de l'emplacement
  de manière isolée.
end note

actor "Bibliothécaire" as Acteur
boundary "RessourceFormComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
entity "EmplacementRepository\n<<entity>>" as EmplacementRepo
database "Base de données" as DB

Acteur -> UI : saisir code emplacement\net libellé (optionnel)
UI -> RessourceController : POST /ressources\n(avec emplacementCode\net emplacementLibelle)
RessourceController -> RessourceService : creer(RessourceCreateRequest)
RessourceService -> EmplacementRepo : findByCode(emplacementCode)
EmplacementRepo -> DB : SELECT emplacement WHERE code = ?

alt Emplacement existant
    DB --> EmplacementRepo : Emplacement trouvé
    EmplacementRepo --> RessourceService : Optional<Emplacement> présent
    RessourceService -> RessourceService : utiliser emplacement existant

else Emplacement inexistant + libellé fourni
    DB --> EmplacementRepo : résultat vide
    EmplacementRepo --> RessourceService : Optional.empty()
    RessourceService -> EmplacementRepo : save(nouvel emplacement\ncode + libelle)
    EmplacementRepo -> DB : INSERT INTO emplacement
    DB --> EmplacementRepo : emplacement persisté
    EmplacementRepo --> RessourceService : Emplacement créé
end

RessourceService --> RessourceController : (poursuite UC08)
RessourceController --> UI : emplacement associé
UI --> Acteur : emplacement confirmé dans\nla fiche ressource

@enduml
