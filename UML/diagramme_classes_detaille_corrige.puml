@startuml
title Diagramme de classes détaillé - Spring Boot (fidèle au code)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

' ============================================================
' DOMAINE MÉTIER
' ============================================================
package "Domaine métier" {

  class Utilisateur {
    - id: Long
    - nom: String
    - prenom: String
    - email: String
    - motDePasse: String
    - type: TypeUtilisateur
    - role: Role
    - cautionDisponible: BigDecimal
    - actif: Boolean
    - emprunts: List<Emprunt>
  }

  enum TypeUtilisateur {
    ETUDIANT
    ENSEIGNANT
    PARTICULIER
    BIBLIOTHECAIRE
  }

  enum Role {
    USER
    BIBLIOTHECAIRE
  }

  abstract class RessourceDocumentaire {
    - id: Long
    - titre: String
    - auteur: String
    - theme: String
    - anneePublication: Integer
    - cautionExigee: BigDecimal
    - emplacement: Emplacement
    - exemplaires: List<Exemplaire>
  }

  class Livre {
    - isbn: String
  }

  class Revue {
    - numero: Integer
  }

  class Exemplaire {
    - id: Long
    - codeBarres: String
    - statut: StatutExemplaire
    - ressource: RessourceDocumentaire
  }

  class Emplacement {
    - id: Long
    - code: String
    - libelle: String
  }

  class Emprunt {
    - id: Long
    - dateEmprunt: LocalDate
    - dateRetourPrevue: LocalDate
    - dateRetour: LocalDate
    - statut: StatutEmprunt
    - exemplaire: Exemplaire
    - utilisateur: Utilisateur
  }

  enum StatutExemplaire {
    DISPONIBLE
    EMPRUNTE
  }

  enum StatutEmprunt {
    EN_COURS
    RETOURNE
    EN_RETARD
  }
}

' ============================================================
' DTOs / Records
' ============================================================
package "DTOs (Records)" {

  entity LoginRequest << record >> {
    + email: String
    + motDePasse: String
  }

  entity LoginResponse << record >> {
    + id: Long
    + email: String
    + nomComplet: String
    + role: String
    + type: String
  }

  entity UtilisateurCreateRequest << record >> {
    + nom: String
    + prenom: String
    + email: String
    + motDePasse: String
    + type: TypeUtilisateur
    + cautionDisponible: BigDecimal
  }

  entity UtilisateurResponse << record >> {
    + id: Long
    + nom: String
    + prenom: String
    + email: String
    + role: String
    + type: String
    + cautionDisponible: BigDecimal
    + actif: Boolean
  }

  entity RessourceCreateRequest << record >> {
    + titre: String
    + auteur: String
    + theme: String
    + anneePublication: Integer
    + cautionExigee: BigDecimal
    + type: TypeRessource
    + isbn: String
    + numero: Integer
    + nombreExemplaires: Integer
    + emplacementCode: String
    + emplacementLibelle: String
  }

  entity RessourceResponse << record >> {
    + id: Long
    + titre: String
    + auteur: String
    + theme: String
    + anneePublication: Integer
    + cautionExigee: BigDecimal
    + type: String
    + referenceSpecifique: String
    + emplacement: String
    + exemplaires: List<ExemplaireResponse>
  }

  entity ExemplaireResponse << record >> {
    + id: Long
    + codeBarres: String
    + statut: String
  }

  entity RechercheRessourceRequest << record >> {
    + titre: String
    + auteur: String
    + theme: String
    + anneePublication: Integer
  }

  entity EmpruntCreateRequest << record >> {
    + utilisateurId: Long
    + ressourceId: Long
  }

  entity EmpruntResponse << record >> {
    + id: Long
    + utilisateurId: Long
    + utilisateur: String
    + ressourceId: Long
    + ressource: String
    + codeBarres: String
    + dateEmprunt: LocalDate
    + dateRetourPrevue: LocalDate
    + dateRetour: LocalDate
    + statut: String
  }

  entity RetourRequest << record >> {
    + empruntId: Long
  }

  entity RelanceResponse << record >> {
    + empruntId: Long
    + message: String
  }
}

' ============================================================
' CONTRÔLEURS
' ============================================================
package "Contrôleurs" {

  class AuthController {
    - authService: AuthService
    + login(LoginRequest): ResponseEntity<LoginResponse>
  }

  class UtilisateurController {
    - utilisateurService: UtilisateurService
    + lister(): List<UtilisateurResponse>
    + creer(UtilisateurCreateRequest): UtilisateurResponse
  }

  class RessourceController {
    - ressourceService: RessourceService
    + creer(RessourceCreateRequest): RessourceResponse
    + rechercheSimple(String): List<RessourceResponse>
    + rechercheAvancee(RechercheRessourceRequest): List<RessourceResponse>
    + detail(Long): RessourceResponse
  }

  class EmpruntController {
    - empruntService: EmpruntService
    + emprunter(EmpruntCreateRequest): EmpruntResponse
    + retourner(RetourRequest): EmpruntResponse
    + listerParUtilisateur(Long): List<EmpruntResponse>
  }

  class RetardController {
    - empruntService: EmpruntService
    - relanceService: RelanceService
    + listerRetards(): List<EmpruntResponse>
    + envoyerRelance(Long): RelanceResponse
  }
}

' ============================================================
' SERVICES
' ============================================================
package "Services" {

  class AuthService {
    - authenticationManager: AuthenticationManager
    - utilisateurRepository: UtilisateurRepository
    + login(LoginRequest): LoginResponse
  }

  class UtilisateurService {
    - utilisateurRepository: UtilisateurRepository
    - passwordEncoder: PasswordEncoder
    + creer(UtilisateurCreateRequest): UtilisateurResponse
    + lister(): List<UtilisateurResponse>
    + getEntity(Long): Utilisateur
    + toResponse(Utilisateur): UtilisateurResponse
  }

  class RessourceService {
    - ressourceRepository: RessourceRepository
    - emplacementRepository: EmplacementRepository
    - ressourceFactory: RessourceFactory
    + creer(RessourceCreateRequest): RessourceResponse
    + rechercheSimple(String): List<RessourceResponse>
    + rechercheAvancee(RechercheRessourceRequest): List<RessourceResponse>
    + detail(Long): RessourceResponse
    + getEntity(Long): RessourceDocumentaire
    + toResponse(RessourceDocumentaire): RessourceResponse
  }

  class EmpruntService {
    - empruntRepository: EmpruntRepository
    - exemplaireRepository: ExemplaireRepository
    - ressourceService: RessourceService
    - utilisateurService: UtilisateurService
    - DUREE_PRET_JOURS: int
    + emprunter(EmpruntCreateRequest): EmpruntResponse
    + retourner(Long): EmpruntResponse
    + listerParUtilisateur(Long): List<EmpruntResponse>
    + listerRetards(): List<EmpruntResponse>
    + updateRetards(): void
    + toResponse(Emprunt): EmpruntResponse
  }

  class RelanceService {
    - empruntRepository: EmpruntRepository
    - empruntService: EmpruntService
    - mailSender: JavaMailSender
    + envoyerRelance(Long): RelanceResponse
  }
}

' ============================================================
' PERSISTANCE
' ============================================================
package "Persistance" {

  interface UtilisateurRepository {
    + findByEmail(String): Optional<Utilisateur>
  }

  interface RessourceRepository {
    + findByTitreContainingIgnoreCase(String): List<RessourceDocumentaire>
    + rechercheAvancee(String, String, Integer, String): List<RessourceDocumentaire>
  }

  interface ExemplaireRepository {
    + findByCodeBarres(String): Optional<Exemplaire>
    + findByRessourceIdAndStatut(Long, StatutExemplaire): List<Exemplaire>
  }

  interface EmpruntRepository {
    + findByUtilisateurId(Long): List<Emprunt>
    + findByExemplaireIdAndStatut(Long, StatutEmprunt): Optional<Emprunt>
    + findEmpruntActifByUtilisateurEtRessource(Long, Long): Optional<Emprunt>
    + findRetardsByUtilisateur(Long): List<Emprunt>
    + findOverdues(LocalDate): List<Emprunt>
    + findByStatut(StatutEmprunt): List<Emprunt>
  }

  interface EmplacementRepository {
    + findByCode(String): Optional<Emplacement>
  }
}

' ============================================================
' DESIGN PATTERN - Factory
' ============================================================
package "Design Pattern (Factory)" {

  class RessourceFactory {
    + create(RessourceCreateRequest, Emplacement): RessourceDocumentaire
    - buildLivre(RessourceCreateRequest, Emplacement): Livre
    - buildRevue(RessourceCreateRequest, Emplacement): Revue
    - generateBarcode(TypeRessource): String
  }

  enum TypeRessource {
    LIVRE
    REVUE
  }
}

' ============================================================
' SÉCURITÉ
' ============================================================
package "Sécurité" {

  class SecurityConfig {
    - utilisateurRepository: UtilisateurRepository
    + securityFilterChain(HttpSecurity): SecurityFilterChain
    + passwordEncoder(): PasswordEncoder
    + userDetailsService(): UserDetailsService
    + authenticationManager(AuthenticationConfiguration): AuthenticationManager
  }

  class ApiExceptionHandler {
    + handleBusiness(BusinessException): ResponseEntity<Map>
    + handleNotFound(NotFoundException): ResponseEntity<Map>
    + handleValidation(MethodArgumentNotValidException): ResponseEntity<Map>
    + handleGeneric(Exception): ResponseEntity<Map>
  }

  class BusinessException
  class NotFoundException
}

' ============================================================
' INITIALISATION
' ============================================================
package "Initialisation" {
  class DataInitializer {
    - passwordEncoder: PasswordEncoder
    + init(...): CommandLineRunner
  }
}

' ============================================================
' RELATIONS - Héritage domaine
' ============================================================
RessourceDocumentaire <|-- Livre
RessourceDocumentaire <|-- Revue

' Relations domaine
Utilisateur "1" *-- "0..*" Emprunt : emprunts
Utilisateur "1" --> "1" TypeUtilisateur
Utilisateur "1" --> "1" Role
Emprunt "1" --> "1" Exemplaire
Emprunt "1" --> "1" StatutEmprunt
Exemplaire "1" --> "1" StatutExemplaire
Exemplaire "1" --> "1" RessourceDocumentaire
RessourceDocumentaire "1" *-- "1..*" Exemplaire : exemplaires
RessourceDocumentaire "1" --> "1" Emplacement

' Relations contrôleurs → services
AuthController --> AuthService
UtilisateurController --> UtilisateurService
RessourceController --> RessourceService
EmpruntController --> EmpruntService
RetardController --> EmpruntService
RetardController --> RelanceService

' Relations services → repositories
AuthService --> UtilisateurRepository
UtilisateurService --> UtilisateurRepository
RessourceService --> RessourceRepository
RessourceService --> EmplacementRepository
RessourceService --> RessourceFactory
EmpruntService --> EmpruntRepository
EmpruntService --> ExemplaireRepository
EmpruntService --> RessourceService
EmpruntService --> UtilisateurService
RelanceService --> EmpruntRepository
RelanceService --> EmpruntService

' Factory
RessourceFactory --> TypeRessource
RessourceCreateRequest --> TypeRessource

' Sécurité
SecurityConfig --> UtilisateurRepository

' DTOs utilisés par les contrôleurs/services
AuthController ..> LoginRequest
AuthController ..> LoginResponse
UtilisateurController ..> UtilisateurCreateRequest
UtilisateurController ..> UtilisateurResponse
RessourceController ..> RessourceCreateRequest
RessourceController ..> RessourceResponse
RessourceController ..> RechercheRessourceRequest
EmpruntController ..> EmpruntCreateRequest
EmpruntController ..> EmpruntResponse
EmpruntController ..> RetourRequest
RetardController ..> RelanceResponse

@enduml
