@startuml
title UC04 - Emprunter un exemplaire (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "EmpruntComponent\n<<boundary>>" as UI
control "EmpruntController\n<<control>>" as EmpruntController
control "EmpruntService\n<<control>>" as EmpruntService
control "UtilisateurService\n<<control>>" as UtilisateurService
control "RessourceService\n<<control>>" as RessourceService
entity "ExemplaireRepository\n<<entity>>" as ExemplaireRepo
entity "EmpruntRepository\n<<entity>>" as EmpruntRepo
database "Base de données" as DB

Acteur -> UI : demander l'emprunt d'une ressource
UI -> EmpruntController : POST /emprunts\n(EmpruntCreateRequest)
EmpruntController -> EmpruntService : emprunter(EmpruntCreateRequest)
EmpruntService -> UtilisateurService : getEntity(utilisateurId)
UtilisateurService -> DB : SELECT utilisateur WHERE id = ?
DB --> UtilisateurService : Utilisateur
UtilisateurService --> EmpruntService : Utilisateur
EmpruntService -> RessourceService : getEntity(ressourceId)
RessourceService -> DB : SELECT ressource WHERE id = ?
DB --> RessourceService : RessourceDocumentaire
RessourceService --> EmpruntService : RessourceDocumentaire

alt Ressource déjà empruntée par l'utilisateur
    EmpruntService -> EmpruntRepo : findEmpruntActifByUtilisateurEtRessource\n(utilisateurId, ressourceId)
    EmpruntRepo -> DB : SELECT emprunt actif
    DB --> EmpruntRepo : emprunt existant
    EmpruntRepo --> EmpruntService : Optional<Emprunt> présent
    EmpruntService --> EmpruntController : BusinessException\n("Vous empruntez déjà cette ressource")
    EmpruntController --> UI : 400 Bad Request
    UI --> Acteur : message "Vous empruntez déjà\ncette ressource"

else Emprunt en retard existant
    EmpruntService -> EmpruntRepo : findRetardsByUtilisateur(utilisateurId)
    EmpruntRepo -> DB : SELECT emprunts EN_RETARD
    DB --> EmpruntRepo : liste non vide
    EmpruntRepo --> EmpruntService : List<Emprunt> avec retards
    EmpruntService --> EmpruntController : BusinessException\n("Emprunt(s) en retard non soldé(s)")
    EmpruntController --> UI : 400 Bad Request
    UI --> Acteur : message "Vous avez des emprunts\nen retard"

else Caution insuffisante
    EmpruntService -> EmpruntService : cautionDisponible\n< cautionExigee
    EmpruntService --> EmpruntController : BusinessException\n("Caution insuffisante")
    EmpruntController --> UI : 400 Bad Request
    UI --> Acteur : message "Caution insuffisante\npour cet emprunt"

else Aucun exemplaire disponible
    EmpruntService -> ExemplaireRepo : findByRessourceIdAndStatut\n(ressourceId, DISPONIBLE)
    ExemplaireRepo -> DB : SELECT exemplaire DISPONIBLE
    DB --> ExemplaireRepo : liste vide
    ExemplaireRepo --> EmpruntService : List vide
    EmpruntService --> EmpruntController : BusinessException\n("Aucun exemplaire disponible")
    EmpruntController --> UI : 400 Bad Request
    UI --> Acteur : message "Aucun exemplaire\ndisponible"
end

@enduml
