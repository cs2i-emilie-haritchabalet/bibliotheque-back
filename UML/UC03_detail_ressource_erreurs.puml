@startuml
title UC03 - Consulter le détail d'une ressource (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "RessourceDetailComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
entity "RessourceRepository\n<<entity>>" as RessourceRepo
database "Base de données" as DB

Acteur -> UI : accéder à l'URL d'une ressource\n(id inexistant)
UI -> RessourceController : GET /ressources/{id}
RessourceController -> RessourceService : detail(id)
RessourceService -> RessourceRepo : findById(id)
RessourceRepo -> DB : SELECT ressource WHERE id = ?
DB --> RessourceRepo : résultat vide
RessourceRepo --> RessourceService : Optional.empty()
RessourceService --> RessourceController : NotFoundException\n("Ressource introuvable")
RessourceController --> UI : 404 Not Found
UI --> Acteur : message "Ressource introuvable"

@enduml
