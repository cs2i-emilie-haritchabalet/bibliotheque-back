@startuml
title UC07 - Enregistrer un nouvel utilisateur (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Bibliothécaire" as Acteur
boundary "UtilisateurFormComponent\n<<boundary>>" as UI
control "UtilisateurController\n<<control>>" as UtilisateurController
control "UtilisateurService\n<<control>>" as UtilisateurService
entity "UtilisateurRepository\n<<entity>>" as UserRepo
database "Base de données" as DB

Acteur -> UI : saisir les informations utilisateur
UI -> UtilisateurController : POST /utilisateurs\n(UtilisateurCreateRequest)

alt Données invalides (validation Bean)
    UtilisateurController -> UtilisateurController : @Valid échoue\n(champ manquant ou invalide)
    UtilisateurController --> UI : 400 Bad Request\n(MethodArgumentNotValidException)
    UI --> Acteur : message "Données invalides\n(champs obligatoires manquants)"

else Email déjà utilisé
    UtilisateurController -> UtilisateurService : creer(UtilisateurCreateRequest)
    UtilisateurService -> UserRepo : save(utilisateur)
    UserRepo -> DB : INSERT INTO utilisateur
    DB --> UserRepo : violation contrainte UNIQUE (email)
    UserRepo --> UtilisateurService : DataIntegrityViolationException
    UtilisateurService --> UtilisateurController : BusinessException\n("Email déjà utilisé")
    UtilisateurController --> UI : 400 Bad Request
    UI --> Acteur : message "Cet email est\ndéjà utilisé"
end

@enduml
