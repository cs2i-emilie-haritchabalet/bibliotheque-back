@startuml
title UC06 - Retourner un exemplaire (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "MesEmpruntsComponent\n<<boundary>>" as UI
control "EmpruntController\n<<control>>" as EmpruntController
control "EmpruntService\n<<control>>" as EmpruntService
entity "EmpruntRepository\n<<entity>>" as EmpruntRepo
database "Base de données" as DB

Acteur -> UI : demander le retour d'un emprunt
UI -> EmpruntController : POST /emprunts/retour\n(RetourRequest: empruntId)
EmpruntController -> EmpruntService : retourner(empruntId)
EmpruntService -> EmpruntRepo : findById(empruntId)

alt Emprunt introuvable
    EmpruntRepo -> DB : SELECT emprunt WHERE id = ?
    DB --> EmpruntRepo : résultat vide
    EmpruntRepo --> EmpruntService : Optional.empty()
    EmpruntService --> EmpruntController : NotFoundException\n("Emprunt introuvable")
    EmpruntController --> UI : 404 Not Found
    UI --> Acteur : message "Emprunt introuvable"

else Emprunt déjà retourné
    EmpruntRepo -> DB : SELECT emprunt WHERE id = ?
    DB --> EmpruntRepo : Emprunt (statut = RETOURNE)
    EmpruntRepo --> EmpruntService : Emprunt
    EmpruntService -> EmpruntService : vérifier statut → RETOURNE
    EmpruntService --> EmpruntController : BusinessException\n("Emprunt déjà retourné")
    EmpruntController --> UI : 400 Bad Request
    UI --> Acteur : message "Cet emprunt a déjà\nété retourné"
end

@enduml
