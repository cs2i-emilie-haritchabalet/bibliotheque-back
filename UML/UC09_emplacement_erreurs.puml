@startuml
title UC09 - Associer un emplacement à une ressource (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Bibliothécaire" as Acteur
boundary "RessourceFormComponent\n<<boundary>>" as UI
control "RessourceController\n<<control>>" as RessourceController
control "RessourceService\n<<control>>" as RessourceService
entity "EmplacementRepository\n<<entity>>" as EmplacementRepo
database "Base de données" as DB

Acteur -> UI : saisir code emplacement\nsans libellé
UI -> RessourceController : POST /ressources\n(emplacementCode renseigné,\nemplacementLibelle vide)
RessourceController -> RessourceService : creer(RessourceCreateRequest)
RessourceService -> EmplacementRepo : findByCode(emplacementCode)
EmplacementRepo -> DB : SELECT emplacement WHERE code = ?

alt Code emplacement introuvable + libellé absent
    DB --> EmplacementRepo : résultat vide
    EmplacementRepo --> RessourceService : Optional.empty()
    RessourceService -> RessourceService : libellé non fourni\n→ impossible de créer l'emplacement
    RessourceService --> RessourceController : NotFoundException\n("Emplacement introuvable")
    RessourceController --> UI : 404 Not Found
    UI --> Acteur : message "Emplacement introuvable,\nveuillez fournir un libellé\npour le créer"

else Code emplacement vide ou null
    RessourceController -> RessourceController : @Valid échoue\n(emplacementCode obligatoire)
    RessourceController --> UI : 400 Bad Request\n(MethodArgumentNotValidException)
    UI --> Acteur : message "Le code emplacement\nest obligatoire"

else Erreur de persistance emplacement
    DB --> EmplacementRepo : résultat vide
    EmplacementRepo --> RessourceService : Optional.empty()
    RessourceService -> EmplacementRepo : save(nouvel emplacement)
    EmplacementRepo -> DB : INSERT INTO emplacement
    DB --> EmplacementRepo : erreur contrainte\n(code déjà existant en concurrence)
    EmplacementRepo --> RessourceService : DataIntegrityViolationException
    RessourceService --> RessourceController : BusinessException\n("Erreur lors de la création\nde l'emplacement")
    RessourceController --> UI : 400 Bad Request
    UI --> Acteur : message "Erreur lors de\nl'association de l'emplacement"
end

@enduml
