@startuml
title UC01 - Se connecter (erreurs)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur /\nBibliothécaire" as Acteur
boundary "LoginComponent\n<<boundary>>" as UI
control "AuthController\n<<control>>" as AuthController
control "AuthService\n<<control>>" as AuthService
entity "UtilisateurRepository\n<<entity>>" as UserRepo
database "Base de données" as DB

Acteur -> UI : saisir email + mot de passe
UI -> AuthController : POST /auth/login\n(LoginRequest)
AuthController -> AuthService : login(LoginRequest)
AuthService -> UserRepo : findByEmail(email)
UserRepo -> DB : SELECT utilisateur\nWHERE email = ?

alt Utilisateur introuvable
    DB --> UserRepo : résultat vide
    UserRepo --> AuthService : Optional.empty()
    AuthService --> AuthController : NotFoundException\n("Utilisateur non trouvé")
    AuthController --> UI : 404 Not Found
    UI --> Acteur : message "Identifiants incorrects"

else Mot de passe incorrect
    DB --> UserRepo : utilisateur trouvé
    UserRepo --> AuthService : Optional<Utilisateur>
    AuthService -> AuthService : passwordEncoder.matches()\n→ false
    AuthService --> AuthController : BadCredentialsException
    AuthController --> UI : 401 Unauthorized
    UI --> Acteur : message "Identifiants incorrects"

else Compte désactivé
    DB --> UserRepo : utilisateur trouvé (actif = false)
    UserRepo --> AuthService : Optional<Utilisateur>
    AuthService -> AuthService : vérifier actif → false
    AuthService --> AuthController : BusinessException\n("Compte désactivé")
    AuthController --> UI : 400 Bad Request
    UI --> Acteur : message "Compte désactivé"
end

@enduml
