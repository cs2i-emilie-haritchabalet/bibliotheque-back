@startuml
title UC05 - Consulter la liste de ses emprunts (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Utilisateur" as Acteur
boundary "MesEmpruntsComponent\n<<boundary>>" as UI
control "EmpruntController\n<<control>>" as EmpruntController
control "EmpruntService\n<<control>>" as EmpruntService
entity "EmpruntRepository\n<<entity>>" as EmpruntRepo
database "Base de données" as DB

Acteur -> UI : accéder à "Mes emprunts"
UI -> EmpruntController : GET /emprunts/utilisateur/{id}
EmpruntController -> EmpruntService : listerParUtilisateur(utilisateurId)
EmpruntService -> EmpruntRepo : findByUtilisateurId(utilisateurId)
EmpruntRepo -> DB : SELECT emprunts\nWHERE utilisateur_id = ?
DB --> EmpruntRepo : List<Emprunt>
EmpruntRepo --> EmpruntService : List<Emprunt>
EmpruntService -> EmpruntService : toResponse() pour chaque emprunt
EmpruntService --> EmpruntController : List<EmpruntResponse>
EmpruntController --> UI : 200 OK + List<EmpruntResponse>
UI --> Acteur : afficher liste des emprunts\n(statut, dates, ressource, code-barres)

@enduml
