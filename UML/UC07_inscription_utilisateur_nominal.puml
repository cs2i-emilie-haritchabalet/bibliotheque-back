@startuml
title UC07 - Enregistrer un nouvel utilisateur (nominal)
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333
skinparam sequenceLifeLineBorderColor #999

actor "Bibliothécaire" as Acteur
boundary "UtilisateurFormComponent\n<<boundary>>" as UI
control "UtilisateurController\n<<control>>" as UtilisateurController
control "UtilisateurService\n<<control>>" as UtilisateurService
entity "UtilisateurRepository\n<<entity>>" as UserRepo
database "Base de données" as DB

Acteur -> UI : accéder au formulaire\nd'inscription utilisateur
Acteur -> UI : saisir nom, prénom, email,\nmot de passe, type, caution
UI -> UtilisateurController : POST /utilisateurs\n(UtilisateurCreateRequest)
UtilisateurController -> UtilisateurService : creer(UtilisateurCreateRequest)
UtilisateurService -> UtilisateurService : passwordEncoder.encode(motDePasse)
UtilisateurService -> UtilisateurService : attribuer Role selon TypeUtilisateur\n(BIBLIOTHECAIRE → Role.BIBLIOTHECAIRE\nautres → Role.USER)
UtilisateurService -> UserRepo : save(utilisateur)
UserRepo -> DB : INSERT INTO utilisateur
DB --> UserRepo : utilisateur persisté
UserRepo --> UtilisateurService : Utilisateur
UtilisateurService --> UtilisateurController : UtilisateurResponse
UtilisateurController --> UI : 200 OK + UtilisateurResponse
UI --> Acteur : confirmation création\n(id, email, type, rôle)

@enduml
