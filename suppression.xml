<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- DOMPurify 3.2.4 embarque dans swagger-ui-5.21.0 (via springdoc 2.8.17)
         CVE XSS cote client uniquement - Swagger expose en environnement interne
         a revoir quand springdoc embarque une version corrigee de swagger-ui -->
    <suppress>
        <notes>DOMPurify 3.2.4 dans swagger-ui - risque accepté, exposition interne uniquement</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2025-15599</cve>
        <cve>CVE-2026-0540</cve>
        <cve>CVE-2026-41238</cve>
        <cve>CVE-2026-41239</cve>
        <cve>CVE-2026-41240</cve>
    </suppress>

    <!-- hibernate-validator 8.0.3.Final - version geree par Spring Boot 3.5.14 BOM
         Pas de version corrective disponible dans la branche Spring Boot 3.x
         a revoir lors du passage a Spring Boot 4.x -->
    <suppress>
        <notes>hibernate-validator 8.0.3.Final - aucune version corrective disponible dans Spring Boot 3.x</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate\-validator@8\.0\.3\.Final$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <suppress>
        <notes>
            angus-activation 2.0.3 transitif via jakarta.mail 2.0.4 (Spring Boot BOM)
            aucune version corrective disponible sans upgrade Jakarta Mail / Spring Boot
            risque jugé faible dans contexte serveur
        </notes>

        <packageUrl regex="true">
            ^pkg:maven/org\.eclipse\.angus/angus-activation@2\.0\.3$
        </packageUrl>

        <cve>CVE-2025-7962</cve>
    </suppress>
</suppressions>
